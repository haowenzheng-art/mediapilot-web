# MediaPilot 配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制系统

# ==================== 后端服务配置 ====================

# 服务监听地址和端口
API_HOST=127.0.0.1
API_PORT=8000

# ==================== 开发模式 ====================
# True 时：绕过认证（使用 dev user）、放宽限流、CORS 开放
# 生产环境必须设为 False
DEV_MODE=false

# ==================== 数据库 ====================
# SQLite: sqlite:///./mediapilot.db
# PostgreSQL: postgresql://user:password@localhost:5432/mediapilot
# MySQL: mysql+pymysql://user:password@localhost:3306/mediapilot
DATABASE_URL=sqlite:///./mediapilot.db

# ==================== 认证配置 ====================
# JWT 签名密钥（生产环境必须替换为强随机值，>= 32 字符且不能以 "dev-secret" 开头）
# 生成强随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=please-replace-with-a-strong-random-secret-of-32-or-more-chars

# 新用户默认配额
DEFAULT_QUOTA=100

# ==================== CORS 跨域 ====================
# 逗号分隔的前端地址列表（生产环境填实际域名）
# DEV_MODE=false 时不能为空
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== Redis / 任务队列 ====================
# ARQ worker 用，与 APScheduler 共用
REDIS_URL=redis://localhost:6379/0

# ==================== 监控 / 日志 ====================
# Sentry DSN（留空则不接入）
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# 日志保留天数（按日轮转）
LOG_RETENTION_DAYS=7

# ==================== AI 配置 ====================
# AI 提供商: openai, anthropic
# openai: 任何 OpenAI 兼容服务（默认 Agnes AI 代理）
# anthropic: 走 Anthropic 协议（MiniMax 等兼容网关都可用此 provider）
AI_PROVIDER=openai

# AI API 密钥
AI_API_KEY=

# AI API 基础 URL
# MiniMax (Anthropic 兼容): https://api.minimaxi.com/anthropic
# 默认 Agnes AI 代理: https://apihub.agnes-ai.com/v1
AI_BASE_URL=https://apihub.agnes-ai.com/v1

# AI 模型名称
# MiniMax: MiniMax-M3
# 默认: agnes-2.0-flash
AI_MODEL=agnes-2.0-flash

# AI 请求超时（秒）
AI_TIMEOUT=60

# AI 最大重试次数
AI_MAX_RETRIES=3

# ==================== 平台数据 API ====================
# 新榜 API（微博/抖音/小红书热点数据）
XINBANG_API_KEY=

# 灰豚数据 API（小红书账号分析）
HUITUN_API_KEY=

# ==================== 音视频转写 ====================
# 转写引擎: whisper_local, aliyun, volcengine, mock
TRANSCRIBE_ENGINE=whisper_local

# 是否使用 Mock 转写（测试用，不调用真实服务）
USE_MOCK_TRANSCRIBE=false

# Whisper 本地模型配置（whisper_local 引擎）
WHISPER_MODEL=base
WHISPER_LANGUAGE=zh

# 阿里云语音识别（aliyun 引擎）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_APP_KEY=

# 火山引擎语音转写（volcengine 引擎）
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_APP_ID=

# ==================== 文件上传 ====================
# 上传文件存储目录
UPLOAD_DIR=./uploads

# 最大上传大小（字节），默认 100MB
MAX_UPLOAD_SIZE=104857600

# 允许的文件扩展名（逗号分隔）
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.aac
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv

# ==================== 日志 ====================
LOG_LEVEL=INFO

# ==================== 速率限制 ====================
# 是否启用 API 速率限制（开发模式建议关闭）
RATE_LIMIT_ENABLED=true
