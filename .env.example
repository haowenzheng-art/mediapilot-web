# MediaPilot 生产环境配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制系统

# ==================== 后端配置 ====================

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 数据库配置
# SQLite: sqlite:///./mediariot.db
# PostgreSQL: postgresql://user:password@localhost:5432/mediapilot
# MySQL: mysql+pymysql://user:password@localhost:3306/mediapilot
DATABASE_URL=sqlite:///./mediapilot.db


# ==================== 认证配置 ====================
# JWT 密钥（生产环境请修改为强密钥）
JWT_SECRET=your-secret-key-change-in-production

# 用户默认配额
DEFAULT_QUOTA=100

# ==================== 平台数据API配置 ====================
# 热点搜索和对标账号数据源

# 新榜API（https://www.newrank.cn/）
# 用于获取微博、抖音、小红书等平台的热点和对标账号数据
# 申请地址：https://open.newrank.cn/
XINBANG_API_KEY=

# 灰豚数据API（https://www.huitun.com/）
# 用于小红书账号数据和分析
# 申请地址：https://open.huitun.com/
HUITUN_API_KEY=

# 注意：
# 1. 未配置API密钥时，系统会自动使用mock数据
# 2. API调用失败时，会自动降级到mock数据
# 3. 建议配置真实API以获取最新数据

# ==================== AI 配置 ====================
# AI提供商: openai (推荐，火山引擎OpenAI兼容), ark, anthropic
AI_PROVIDER=openai

# AI API密钥
AI_API_KEY=

# AI API基础URL (非anthropic需要)
# 火山引擎 OpenAI兼容端点：https://ark.cn-beijing.volces.com/api/v3
AI_BASE_URL=https://apihub.agnes-ai.com/v1

# AI模型名称（火山引擎需使用接入点ID，格式如 ep-m-xxxxx）
AI_MODEL=

# AI请求超时(秒)
AI_TIMEOUT=60

# AI最大重试次数
AI_MAX_RETRIES=3

# ==================== 音视频转写配置 ====================
# 转写引擎:
#   whisper_local - 本地Whisper模型（需安装whisper+ffmpeg）
#   aliyun        - 阿里云语音识别（需配置AK/SK/AppKey）
#   volcengine    - 火山引擎语音转写（需配置AK/SK/AppID）
#   mock          - 模拟模式（无需安装，返回假数据，用于测试）
# 如果指定的引擎不可用，会自动回退到mock模式
TRANSCRIBE_ENGINE=whisper_local

# Whisper配置（本地转写）
# 可选模型: tiny, base, small, medium, large-v2, large-v3
# base 模型速度较快，large 模型准确率更高
WHISPER_MODEL=base
WHISPER_LANGUAGE=zh  # 转写语言

# 阿里云语音识别配置
# 申请地址: https://help.aliyun.com/document_detail/84479.html
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_APP_KEY=

# 火山引擎语音转写配置
# 申请地址: https://www.volcengine.com/docs/speech-recognition/66429
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_APP_ID=

# 是否使用Mock转写（用于测试，不调用真实转写服务）
USE_MOCK_TRANSCRIBE=false

# ==================== 前端配置 ====================

# AI功能开关
VITE_AI_ENABLED=true

# 火山引擎（字节跳动）API配置
VITE_API_KEY=
VITE_BASE_URL=https://apihub.agnes-ai.com/v1
VITE_MODEL=

# ==================== 可选配置 ====================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 上传文件大小限制 (MB)
MAX_UPLOAD_SIZE=100

# CORS允许的源 (逗号分隔，生产环境需设置具体域名)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
